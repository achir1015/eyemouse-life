## 3D 人體部位名稱（id → 名稱；左右是「病人自己的」左右）
const PARTS := {
	"head_top": "頭頂", "face": "臉", "back_head": "後腦勺", "eye_l": "左眼", "eye_r": "右眼",
	"ear_l": "左耳朵", "ear_r": "右耳朵", "nose": "鼻子", "mouth": "嘴巴",
	"neck": "脖子", "nape": "後頸", "shoulder_l": "左肩膀", "shoulder_r": "右肩膀",
	"chest": "胸口", "upper_back": "上背", "belly": "肚子", "waist": "腰",
	"groin": "下體", "butt": "屁股",
	"uarm_l": "左上臂", "uarm_r": "右上臂", "farm_l": "左前臂", "farm_r": "右前臂",
	"hand_l": "左手", "hand_r": "右手",
	"thigh_l": "左大腿", "thigh_r": "右大腿", "knee_l": "左膝蓋", "knee_r": "右膝蓋",
	"calf_l": "左小腿", "calf_r": "右小腿", "foot_l": "左腳", "foot_r": "右腳",
	"whole": "全身",
}


static func cat(id: String) -> Dictionary:
	for c in CATS:
		if c.id == id:
			return c
	return CATS[0]


static func body_sentence(part_id: String, feel_id: String) -> String:
	var part: String = PARTS.get(part_id, "")
	for f in FEELINGS:
		if f[0] == feel_id:
			if part_id == "whole":
				return "我全身" + f[2]
			return "我的" + part + f[2]
	return part


